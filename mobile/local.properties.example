#local.properties se usa para configurar la app para pruebas de entorno 
#Copia este archivo como local.properties en cada ordenador y ajusta los valores según el entorno.
# El archivo local.properties está ignorado por Git de forma intencionada,
# ya que contiene configuraciones locales de cada desarrollador.

# URL base de la API utilizada por la aplicación Android.
# Configuración actualmente usada en producción:
iaLoversApiBaseUrl=https://ia-lovers.vercel.app/backend/

# Para usar el emulador de Android conectado a XAMPP en el mismo PC:
# iaLoversApiBaseUrl=http://10.0.2.2/IA-Lovers/backend/

# Para usar un dispositivo Android físico conectado a la misma red Wi-Fi:
# Sustituir YOUR_PC_LAN_IP por la IP local del ordenador donde se ejecuta XAMPP.
# Ejemplo:
# iaLoversApiBaseUrl=http://192.168.1.35/IA-Lovers/backend/

# Ejemplo para otros entornos de pruebas:
# iaLoversApiBaseUrl=https://tu-dominio.example/backend/