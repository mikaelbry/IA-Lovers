{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/backend/(.*)",
      "destination": "/backend/index.php"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}
