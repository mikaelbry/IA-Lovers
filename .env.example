# =============================================================================
# IA Lovers - ejemplo de configuración de entorno
# =============================================================================
# Copia este archivo como `.env` en la raíz del proyecto y rellena los valores
# reales si quieres probarlo con tus propio entorno.
#
# El backend PHP carga este archivo automáticamente desde `backend/config` y
# servicios como Storage, ALTCHA y GmailMailer.
#
# La app Android no lee este archivo directamente. Para configurar la URL de la
# API móvil usa `mobile/local.properties` o `mobile/gradle.properties`:
# iaLoversApiBaseUrl=https://tu-dominio.example/backend/
# =============================================================================

# Nombre usado en correos y mensajes del sistema.
APP_NAME=IA-Lovers


# -----------------------------------------------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------------------------------------------
# Puedes usar DATABASE_URL o las variables DB_* separadas. Si defines
# DATABASE_URL, el backend la prioriza sobre DB_HOST, DB_PORT, DB_NAME,
# DB_USER y DB_PASSWORD.

# Opción A: URL completa de conexión.
# Formato habitual:
# DATABASE_URL=postgres://usuario:contraseña@host:puerto/base_de_datos
# DATABASE_URL=

# Opción B: variables separadas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ia_lovers
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_password

# Modo SSL para PostgreSQL. En Supabase normalmente es `require`.
# En local puede ser `disable` si tu PostgreSQL no usa SSL.
DB_SSLMODE=require

# IP directa opcional del host de base de datos. Útil si hay problemas de DNS.
# Déjalo vacío si no lo necesitas.
# DB_HOSTADDR=

# Tiempo máximo de conexión en segundos.
DB_CONNECT_TIMEOUT=5

# Activa prepares emulados. Recomendado cuando se usa el pooler de Supabase
# en puerto 6543.
DB_EMULATE_PREPARES=true


# -----------------------------------------------------------------------------
# Supabase Storage
# -----------------------------------------------------------------------------
# Usado para subir, borrar y publicar imágenes de posts y avatares.

# URL base del proyecto Supabase, sin barra final.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key de Supabase. Es secreta y permite operar contra Storage.
SUPABASE_SERVICE_ROLE_KEY=pon_aqui_tu_service_role_key

# Bucket donde se guardan uploads.
SUPABASE_STORAGE_BUCKET=storage

# URL pública del bucket. Si se deja sin definir, el backend la construye con:
# SUPABASE_URL + /storage/v1/object/public/ + SUPABASE_STORAGE_BUCKET
SUPABASE_STORAGE_PUBLIC_URL=https://tu-proyecto.supabase.co/storage/v1/object/public/storage


# -----------------------------------------------------------------------------
# CAPTCHA
# -----------------------------------------------------------------------------
# CAPTCHA usado por la web en login, registro y recuperación de contraseña.

# Clave HMAC privada. Debe ser larga y aleatoria; mínimo 24 caracteres.
# Ejemplo para generar una en PowerShell:
# [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Min 0 -Max 256 }))
ALTCHA_HMAC_KEY=pon_aqui_una_clave_larga_y_aleatoria

# Caducidad del reto ALTCHA en segundos. Opcional.
ALTCHA_EXPIRE_SECONDS=300

# Dificultad máxima del reto. Opcional; subirlo aumenta coste de CPU cliente.
ALTCHA_MAX_NUMBER=50000


# -----------------------------------------------------------------------------
# Correo SMTP
# -----------------------------------------------------------------------------
# Usado para enviar códigos de verificación de registro, cambio de correo y
# recuperación de contraseña. Con Gmail se recomienda una contraseña de
# aplicación, no la contraseña normal de la cuenta.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Valores habituales: tls o ssl.
SMTP_SECURE=tls

# Usuario y contraseña SMTP.
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=pon_aqui_tu_password_o_app_password

# Remitente visible en los correos.
SMTP_FROM_EMAIL=tu-correo@gmail.com
SMTP_FROM_NAME=IA-Lovers
